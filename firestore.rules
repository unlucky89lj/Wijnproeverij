rules_version = '2';
// Beveiliging van de Wijnproeverij-database: elke proeverij is alleen zichtbaar voor haar leden.
// De verzamelingen beginnen met wijn_, zodat dit naast de Bierproeverij in hetzelfde Firebase-project kan.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{u} { allow read: if signedIn(); allow write: if signedIn() && request.auth.uid == u; }

    function wgrp(g) { return get(/databases/$(db)/documents/wijn_groups/$(g)).data; }
    function wmember(g) { return signedIn() && request.auth.uid in wgrp(g).members; }
    function wadmin(g) { return signedIn() && (request.auth.uid in wgrp(g).admins || request.auth.uid == wgrp(g).owner); }
    match /wijn_codes/{c} { allow read: if signedIn(); allow create: if signedIn(); }
    match /wijn_groups/{g} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid && request.auth.uid in request.resource.data.members;
      allow update, delete: if wadmin(g);
      match /requests/{u} {
        allow create: if signedIn() && request.auth.uid == u;
        allow read, delete: if wadmin(g) || (signedIn() && request.auth.uid == u);
      }
      match /{col}/{doc=**} { allow read, write: if wmember(g); }
    }
    match /wijn_catalog_extra/{d} { allow read, write: if signedIn(); }
    match /wijn_prijzen/{d} { allow read: if signedIn(); allow write: if signedIn(); }
  }
}
